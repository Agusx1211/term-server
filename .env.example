# A password is generated on first boot when this is omitted.
TERM_SERVER_PASSWORD=replace-with-a-long-random-password
TERM_SERVER_HOST=127.0.0.1
TERM_SERVER_PORT=8090
TERM_SERVER_DATA_DIR=/var/lib/term-server
# Startup default; authenticated Settings can persistently switch main/beta.
# TERM_SERVER_UPDATE_CHANNEL=main
# TERM_SERVER_NO_HTTPS=true
# TERM_SERVER_SECURE_COOKIE=true
# TERM_SERVER_ALLOWED_ORIGINS=https://terminal.example.com

# Provider status modules auto-configure when this is omitted: credentials are
# discovered from the environment names below and then from the local agent
# stores (~/.claude/.credentials.json, $CODEX_HOME/auth.json,
# ~/.pi/agent/auth.json, ~/.omp/agent/auth.json). Set an explicit TOML file to
# replace auto-configuration, or disable discovery entirely:
# TERM_SERVER_STATUS_CONFIG=/etc/term-server/status.toml
# TERM_SERVER_NO_STATUS_AUTO=true
#
# Provider credentials are read from term-server's startup environment. On Unix,
# the same-user session broker and terminal children intentionally inherit them,
# so commands run by that user may observe them. They are never accepted from
# the browser, copied into status TOML, serialized in the status API, or logged;
# browser/API/log isolation remains intact.
# Codex and OpenAI normal-module discovery order: CODEX_API_KEY,
# CODEX_ACCESS_TOKEN, OPENAI_API_KEY.
# CODEX_API_KEY=<set-outside-this-example>
# CODEX_ACCESS_TOKEN=<set-outside-this-example>
# OPENAI_API_KEY=<set-outside-this-example>
#
# Claude/Anthropic discovery order:
# CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_API_KEY.
# CLAUDE_CODE_OAUTH_TOKEN=<set-outside-this-example>
# ANTHROPIC_AUTH_TOKEN=<set-outside-this-example>
# ANTHROPIC_API_KEY=<set-outside-this-example>
#
# Z.AI discovery:
# ZAI_API_KEY=<set-outside-this-example>
#
# Admin modules require explicit admin=true in status TOML and use a separate
# credential; normal provider modules never fall back to these names.
# OPENAI_ADMIN_KEY=<set-outside-this-example>
# ANTHROPIC_ADMIN_KEY=<set-outside-this-example>